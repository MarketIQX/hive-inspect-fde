# Copy to .env.local and fill in. For local development, run
# `npx supabase start` and use the values it prints (also documented in
# README.md) — they are fixed, public local-dev demo keys, not secrets.
# For a hosted/production Supabase project, use that project's own
# dashboard values instead.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
